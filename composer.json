{
	"name": "nextcloud/openai_api",
	"description": "Serves an OpenAI-compatible API backed by the Nextcloud Task Processing API",
	"type": "project",
	"license": "AGPL-3.0-or-later",
	"authors": [
		{
			"name": "Nextcloud GmbH and Nextcloud contributors",
			"email": "info@nextcloud.com"
		}
	],
	"require": {
		"php": "^8.3 || ^8.4",
		"bamarni/composer-bin-plugin": "^1.8"
	},
	"require-dev": {
		"nextcloud/ocp": "dev-master"
	},
	"autoload": {
		"psr-4": {
			"OCA\\OpenAiApi\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\OpenAiApi\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"lint": "find . -name \\*.php -not -path './vendor/*' -not -path './vendor-bin/*' -print0 | xargs -0 -n1 php -l",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --no-cache",
		"psalm:update-baseline": "psalm --no-cache --update-baseline",
		"test:unit": "phpunit --config tests/phpunit.xml",
		"post-install-cmd": [
			"@composer bin all install --ansi"
		],
		"post-update-cmd": [
			"@composer bin all install --ansi"
		]
	},
	"config": {
		"allow-plugins": {
			"bamarni/composer-bin-plugin": true
		},
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.3"
		}
	},
	"extra": {
		"bamarni-bin": {
			"bin-links": true,
			"target-directory": "vendor-bin",
			"forward-command": true
		}
	}
}
