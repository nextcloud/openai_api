		"@nextcloud/logger": "^3.0.2",
		"@nextcloud/password-confirmation": "^6.2.1",
		"@nextcloud/router": "^3.0.1",
		"@nextcloud/vue": "^9.14.1",
		"vue": "^3.5.16"
	},
	"devDependencies": {
		"@nextcloud/browserslist-config": "^3.0.1",
		"@nextcloud/eslint-config": "^9.0.1",
		"@nextcloud/stylelint-config": "^3.2.2",
		"@nextcloud/vite-config": "^2.3.5",
		"eslint": "^10.14.0",
		"sass": "^1.83.0",
		"stylelint": "^17.16.0",
		"typescript": "^7.0.2"
	},
	"engines": {
